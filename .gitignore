# --- Data: keep the folders (.gitkeep), ignore their contents ---
data/**
!data/
!data/*/
!data/**/.gitkeep
# Whitelist small tracked files explicitly, e.g.:
# !data/raw/reference_smiles.csv

# --- Generated outputs: keep folders, ignore artifacts ---
logs/**
!logs/
!logs/.gitkeep

models/**
!models/
!models/.gitkeep

results/figures/**
results/metrics/**
results/tables/**
!results/figures/.gitkeep
!results/metrics/.gitkeep
!results/tables/.gitkeep

# --- Local config (the example is tracked, the real one is not) ---
config/config.yaml
config/*.local.*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.jsonc

# --- Folders not needed or old files ---
docs/
dev/
tests/
notebook_old.py

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Scratch / session caches (never part of the submission) ---
tmp/
# marimo caches stay local, but the session snapshot is what molab's static
# preview renders its outputs from -- commit it
__marimo__/*
!__marimo__/session/
__marimo__/session/*
!__marimo__/session/notebook_slim.py.json

# --- Notebook assets ARE tracked: they are what molab fetches over raw URLs ---
!assets/
!assets/**
